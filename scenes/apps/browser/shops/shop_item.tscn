[node name="shop_item" type="PanelContainer" node_paths=PackedStringArray("item_name_label", "item_price_label", "item_icon_rect", "item_quantity_label", "add_button")]
size_flags_horizontal = 3
mouse_filter = 1
theme_override_styles/panel = SubResource("StyleBoxFlat_card")
script = ExtResource("s_item")
item_name_label = NodePath("Column/ItemNameLabel")
item_price_label = NodePath("Column/ItemPriceLabel")
item_icon_rect = NodePath("Column/ImagePanel/ItemIcon")
item_quantity_label = NodePath("Column/Stepper/StepperRow/ItemQuantity")
add_button = NodePath("Column/AddToCartButton")

[node name="Column" type="VBoxContainer" parent="."]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 8

[node name="ImagePanel" type="PanelContainer" parent="Column"]
clip_contents = true
custom_minimum_size = Vector2(0, 112)
layout_mode = 2
mouse_filter = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_image")

[node name="ItemIcon" type="TextureRect" parent="Column/ImagePanel"]
layout_mode = 2
mouse_filter = 2
texture = ExtResource("t_product")
expand_mode = 1
stretch_mode = 5

[node name="ItemNameLabel" type="Label" parent="Column"]
custom_minimum_size = Vector2(10, 0)
layout_mode = 2
size_flags_vertical = 3
text = "Nome do Item"
label_settings = SubResource("LabelSettings_name")
autowrap_mode = 3
text_overrun_behavior = 3
max_lines_visible = 2

[node name="ItemPriceLabel" type="Label" parent="Column"]
layout_mode = 2
text = "R$ 130,00"
label_settings = SubResource("LabelSettings_price")

[node name="Stepper" type="PanelContainer" parent="Column"]
layout_mode = 2
size_flags_horizontal = 3
mouse_filter = 1
theme_override_styles/panel = SubResource("StyleBoxFlat_stepper")

[node name="StepperRow" type="HBoxContainer" parent="Column/Stepper"]
layout_mode = 2
theme_override_constants/separation = 0

[node name="RemoveButton" type="Button" parent="Column/Stepper/StepperRow"]
custom_minimum_size = Vector2(26, 26)
layout_mode = 2
focus_mode = 0
mouse_filter = 1
theme_override_colors/font_color = Color(0.09019608, 0.10980392, 0.18039216, 1)
theme_override_colors/font_hover_color = Color(0.09019608, 0.10980392, 0.18039216, 1)
theme_override_colors/font_pressed_color = Color(0.09019608, 0.10980392, 0.18039216, 1)
theme_override_fonts/font = ExtResource("f_bold")
theme_override_font_sizes/font_size = 16
theme_override_styles/focus = SubResource("StyleBoxEmpty_focus")
theme_override_styles/normal = SubResource("StyleBoxEmpty_step")
theme_override_styles/hover = SubResource("StyleBoxFlat_step_hover")
theme_override_styles/pressed = SubResource("StyleBoxFlat_step_pressed")
text = "−"

[node name="ItemQuantity" type="Label" parent="Column/Stepper/StepperRow"]
custom_minimum_size = Vector2(24, 0)
layout_mode = 2
size_flags_horizontal = 3
text = "1"
label_settings = SubResource("LabelSettings_quantity")
horizontal_alignment = 1
vertical_alignment = 1

[node name="AddButton" type="Button" parent="Column/Stepper/StepperRow"]
custom_minimum_size = Vector2(26, 26)
layout_mode = 2
focus_mode = 0
mouse_filter = 1
theme_override_colors/font_color = Color(0.09019608, 0.10980392, 0.18039216, 1)
theme_override_colors/font_hover_color = Color(0.09019608, 0.10980392, 0.18039216, 1)
theme_override_colors/font_pressed_color = Color(0.09019608, 0.10980392, 0.18039216, 1)
theme_override_fonts/font = ExtResource("f_bold")
theme_override_font_sizes/font_size = 16
theme_override_styles/focus = SubResource("StyleBoxEmpty_focus")
theme_override_styles/normal = SubResource("StyleBoxEmpty_step")
theme_override_styles/hover = SubResource("StyleBoxFlat_step_hover")
theme_override_styles/pressed = SubResource("StyleBoxFlat_step_pressed")
text = "+"

[node name="AddToCartButton" type="Button" parent="Column"]
layout_mode = 2
focus_mode = 0
mouse_filter = 1
theme_override_colors/font_color = Color(1, 1, 1, 1)
theme_override_colors/font_hover_color = Color(1, 1, 1, 1)
theme_override_colors/font_pressed_color = Color(1, 1, 1, 1)
