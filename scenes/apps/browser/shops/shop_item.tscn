theme_override_styles/hover = SubResource("StyleBoxFlat_add_normal")
theme_override_styles/pressed = SubResource("StyleBoxFlat_add_pressed")
text = "Adicionar"

[connection signal="pressed" from="Column/Stepper/StepperRow/RemoveButton" to="." method="_on_remove_item_pressed"]
[connection signal="pressed" from="Column/Stepper/StepperRow/AddButton" to="." method="_on_add_item_pressed"]
[connection signal="pressed" from="Column/AddToCartButton" to="." method="_on_add_to_cart_pressed"]
