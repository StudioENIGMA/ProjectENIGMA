{
	"conversation_id": "jose_gd5",
	"contact_name": "José",
	"branches": {
		"d5g01_jose": [
			{
				"id": "d5g01_jose_0",
				"text": "Boa tarde. Sabia que empilhadeira não freia em piso molhado?"
			},
			{
				"id": "d5g01_jose_1",
				"text": "Eu também não sabia. Até terça-feira.",
				"choices": [
					{
						"id": "d5g01_jose_2_0",
						"player_text": "Nossa! Alguém se machucou?",
						"npc_reply": {
							"goto_branch": "d5g01_jose_ninguem",
							"delay_ticks": 3
						}
					},
					{
						"id": "d5g01_jose_2_1",
						"player_text": "Eita. O que ela atropelou?",
						"npc_reply": {
							"goto_branch": "d5g01_jose_grade",
							"delay_ticks": 3
						}
					}
				]
			}
		],
		"d5g01_jose_ninguem": [
			{
				"id": "d5g01_jose_2",
				"text": "Felizmente não. Só as grades do depósito, que estavam no caminho.",
				"choices": [
					{
						"id": "d5g01_jose_3_0",
						"player_text": "Ufa. Sobrou alguma?",
						"npc_reply": {
							"goto_branch": "d5g01_jose_fim",
							"delay_ticks": 3
						}
					},
					{
						"id": "d5g01_jose_3_1",
						"player_text": "Pobres grades",
						"npc_reply": {
							"goto_branch": "d5g01_jose_fim",
							"delay_ticks": 3
						}
					}
				]
			}
		],
		"d5g01_jose_grade": [
			{
				"id": "d5g01_jose_3",
				"text": "As grades do depósito. Com convicção, inclusive.",
				"choices": [
					{
						"id": "d5g01_jose_4_0",
						"player_text": "Quem tava dirigindo, seu José?",
						"npc_reply": {
							"goto_branch": "d5g01_jose_fim",
							"delay_ticks": 3
						}
					},
					{
						"id": "d5g01_jose_4_1",
						"player_text": "Kkkk e agora?",
